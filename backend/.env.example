# ==============================================================================
# Anveshana Club Backend - Environment Configuration
# ==============================================================================

# Server Environment
# Options: development | production | test
NODE_ENV=production

# Server Port (Render, Railway, Heroku will supply this automatically)
PORT=5000

# Allowed Frontend Origins for CORS (comma-separated for multiple origins)
# Example: https://anveshana-rho.vercel.app,https://anveshana-club.vercel.app
CLIENT_URL=https://anveshana-rho.vercel.app

# ==============================================================================
# Database Configuration (MongoDB Atlas)
# ==============================================================================
# Standard SRV connection string with username, password, and database name
# Production database: anveshana_prod | Development database: anveshana_dev
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/anveshana_prod?retryWrites=true&w=majority

# ==============================================================================
# Security & Authentication (JWT + Cookies)
# ==============================================================================
# Strong 64-character secret key. Generate using:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_cryptographically_secure_random_64_char_key
JWT_EXPIRES_IN=2h

# Cookie SameSite attribute
# Use 'none' for cross-domain deployments (e.g. Vercel frontend + Render backend)
# Use 'lax' for same-domain or single-origin deployments
COOKIE_SAME_SITE=none

# Cookie Secure flag (Must be true when COOKIE_SAME_SITE=none over HTTPS)
COOKIE_SECURE=true

# Initial Administrator Account (Used during 'npm run seed:admin')
ADMIN_DEFAULT_EMAIL=admin@anveshana-mbu.in
ADMIN_DEFAULT_PASSWORD=replace_with_a_strong_password_16_chars_min

# ==============================================================================
# Cloudinary Media Storage (Event Banners, Gallery Photos, Logos)
# ==============================================================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

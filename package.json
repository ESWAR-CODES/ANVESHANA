{
  "name": "anveshana-club-website",
  "version": "1.0.0",
  "private": true,
  "description": "Official Web Platform for Anveshana Club at Mohan Babu University (MBU)",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "start": "npm --prefix backend run start",
    "test:backend": "npm --prefix backend test",
    "test": "npm --prefix backend test",
    "seed": "npm --prefix backend run seed",
    "seed:admin": "npm --prefix backend run seed:admin",
    "seed:categories": "npm --prefix backend run seed:categories",
    "lint:frontend": "npm --prefix frontend run lint",
    "lint:backend": "npm --prefix backend run lint",
    "lint": "npm run lint:backend && npm run lint:frontend"
  },
  "keywords": [
    "anveshana",
    "mbu",
    "mohan-babu-university",
    "mern"
  ],
  "author": "Anveshana Club Core Team",
  "license": "ISC"
}
